rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Quiz attempts: anyone can read, anyone can add a valid score, nobody can edit or delete from the site.
    match /attempts/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['subject','subjectName','name','player','score','total','at'])
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 80
        && request.resource.data.subjectName is string && request.resource.data.subjectName.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.player is string && request.resource.data.player.size() <= 40
        && request.resource.data.score is int && request.resource.data.total is int
        && request.resource.data.total > 0 && request.resource.data.total <= 500
        && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
