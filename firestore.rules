rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isEditor() { return signedIn() && exists(/databases/$(database)/documents/editors/$(request.auth.uid)); }

    // Site owner(s): add a document here with your account ID, from the Firebase console only.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // One document per signed-in person. Only the owner can read them all.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','email','photo','firstSeen','lastSeen','visits','app','progressAt','progressViews','nick'])
        && (!('nick' in request.resource.data) || (request.resource.data.nick is string && request.resource.data.nick.size() <= 20))
        && (!('app' in request.resource.data) || request.resource.data.app is timestamp)
        && (!('progressAt' in request.resource.data) || request.resource.data.progressAt is timestamp)
        && (!('progressViews' in request.resource.data) || request.resource.data.progressViews is int)
        && request.resource.data.lastSeen == request.time
        && request.resource.data.visits is int;
      allow delete: if false;
    }

    // Friends the owner lets edit the schedule. Only the owner can add or remove them.
    match /editors/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['name','email','at']);
      allow delete: if isAdmin();
    }

    // Weekly schedule: everyone signed in can see it; the owner and editors can change it.
    match /events/{id} {
      allow read: if signedIn();
      allow create, update: if (isAdmin() || isEditor())
        && request.resource.data.keys().hasOnly(['title','type','subject','date','endDate','time','notes','by','byName','at'])
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.type in ['quiz','exam','lecture','deadline','reminder','other']
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 80
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('endDate' in request.resource.data) || (request.resource.data.endDate is string && request.resource.data.endDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') && request.resource.data.endDate > request.resource.data.date))
        && request.resource.data.time is string && request.resource.data.time.size() <= 5
        && request.resource.data.notes is string && request.resource.data.notes.size() <= 1000
        && request.resource.data.by == request.auth.uid
        && request.resource.data.byName is string && request.resource.data.byName.size() <= 80
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || isEditor();
    }

    // Suggestion box: anyone signed in can send one; only the owner can read or clear them.
    match /suggestions/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['text','category','name','uid','at'])
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.category in ['idea','notes','bug','other']
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && (request.resource.data.uid == '' || request.resource.data.uid == request.auth.uid)
        && request.resource.data.at == request.time;
      allow update: if false;
    }

    // Share your notes: anyone signed in can send a link; only the owner can read or clear them.
    match /shares/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['link','title','subject','message','name','uid','at'])
        && request.resource.data.link is string && request.resource.data.link.matches('^https://.+') && request.resource.data.link.size() <= 500
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 120
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 80
        && request.resource.data.message is string && request.resource.data.message.size() <= 1000
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && (request.resource.data.uid == '' || request.resource.data.uid == request.auth.uid)
        && request.resource.data.at == request.time;
      allow update: if false;
    }

    // Who's online: each signed-in person keeps one heartbeat document fresh.
    match /presence/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','at','doc','hidden','photo','streak','badges'])
        && (!('photo' in request.resource.data) || (request.resource.data.photo is string && request.resource.data.photo.size() <= 500))
        && (!('streak' in request.resource.data) || request.resource.data.streak is int)
        && (!('badges' in request.resource.data) || request.resource.data.badges is int)
        && (!('hidden' in request.resource.data) || request.resource.data.hidden is bool)
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && (!('doc' in request.resource.data) || (request.resource.data.doc is string && request.resource.data.doc.size() <= 100))
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Public download counts per note: only ever goes up by one.
    match /downloads/{noteId} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == 1;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['count']) && request.resource.data.count == resource.data.count + 1;
      allow delete: if false;
    }

    // Who downloaded what. Only the owner can read it.
    match /downloadLog/{id} {
      allow read: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','name','noteId','noteTitle','subject','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.at == request.time
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.noteId is string && request.resource.data.noteId.size() <= 100
        && request.resource.data.noteTitle is string && request.resource.data.noteTitle.size() <= 120
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 80;
      allow update, delete: if false;
    }

    // Quiz attempts: signed-in people read the leaderboard and add their own scores.
    match /attempts/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['subject','subjectName','name','player','score','total','at'])
        && request.resource.data.player == request.auth.uid
        && request.resource.data.subject is string && request.resource.data.subject.size() <= 80
        && request.resource.data.subjectName is string && request.resource.data.subjectName.size() <= 80
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.score is int && request.resource.data.total is int
        && request.resource.data.total > 0 && request.resource.data.total <= 500
        && request.resource.data.score >= 0 && request.resource.data.score <= request.resource.data.total
        && request.resource.data.at == request.time;
      allow update, delete: if isAdmin();
    }

    // Emoji reactions on PDFs: one document per person per PDF, holding the emojis they picked.
    match /reactions/{rid} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['doc','uid','name','es','at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.doc is string && request.resource.data.doc.size() > 0 && request.resource.data.doc.size() <= 100
        && rid == request.resource.data.doc + '__' + request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.es is list && request.resource.data.es.size() > 0 && request.resource.data.es.size() <= 7
        && request.resource.data.es.hasOnly(['❤️','🔥','🙏','🧠','🦴','💪','🩺'])
        && request.resource.data.es.toSet().size() == request.resource.data.es.size()
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Nudges: a signed-in person can buzz someone; only the person nudged can read or clear it.
    match /nudges/{id} {
      allow read, delete: if signedIn() && resource.data.to == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['to','from','fromName','at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.to.size() > 0 && request.resource.data.to.size() <= 128
        && request.resource.data.to != request.auth.uid
        && request.resource.data.fromName is string && request.resource.data.fromName.size() <= 80
        && request.resource.data.at == request.time;
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
